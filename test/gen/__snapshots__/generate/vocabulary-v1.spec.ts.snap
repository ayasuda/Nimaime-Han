test.describe('Screen: Settings', () => {
  test.describe('Element: Newsletter', () => {
    test('Always', async ({ $nimaime, page }) => {
      await $nimaime.run(
        { page },
        {
          screen: 'Settings',
          element: 'Newsletter',
          expectations: [
            {
              kind: 'text',
              target: 'Title',
              value: 'Say "hi" \\ it\'s me',
              location: { line: 3, column: 5 },
            },
            { kind: 'enable', location: { line: 4, column: 5 } },
            { kind: 'check', target: 'Remember me', location: { line: 5, column: 5 } },
          ],
          file,
          locations: { screen: { line: 1, column: 1 }, element: { line: 2, column: 3 } },
        },
      );
    });

    test('When: The user subscribed', async ({ $nimaime, page }) => {
      await $nimaime.run(
        { page },
        {
          screen: 'Settings',
          element: 'Newsletter',
          conditions: ['The user subscribed'],
          expectations: [
            { kind: 'check', location: { line: 8, column: 5 } },
            {
              kind: 'contain',
              target: 'Title',
              value:
                'A rather long welcome text that does not fit on one line of the generated plan',
              location: { line: 9, column: 5 },
            },
            { kind: 'count', target: 'Items', value: 3, location: { line: 10, column: 5 } },
          ],
          file,
          locations: {
            screen: { line: 1, column: 1 },
            element: { line: 2, column: 3 },
