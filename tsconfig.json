{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    // Lets code in this repository (e.g. test/e2e/gen) import the package by name for type
    // checking without a build. At run time Node resolves it through "exports" (dist/).
    "paths": {
      "nimaime-han": ["./src/index.ts"],
      "nimaime-han/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
